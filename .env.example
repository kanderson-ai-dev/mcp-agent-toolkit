# ── LLM (agent client) ────────────────────────────────────────────────
# Required for the live agent. Leave empty → deterministic StubLLM
# replays a scripted tool-call plan (fully offline, used by tests/CI).
OPENAI_API_KEY=
CHAT_MODEL_NAME=gpt-4o-mini
LLM_PROVIDER=auto            # auto | openai | stub

# ── Web search (web_search tool) ──────────────────────────────────────
# No key → keyless DuckDuckGo. "none" → offline canned results.
SEARCH_PROVIDER=auto         # auto | tavily | duckduckgo | none
SEARCH_API_KEY=              # Tavily key (optional, paid provider)

# ── MCP server ────────────────────────────────────────────────────────
# Command the client spawns.
# Default: sys.executable -m mcp_toolkit.server
# MCP_SERVER_COMMAND=
# MCP_SERVER_ARGS=
SANDBOX_ROOT=./data/sandbox  # the ONLY filesystem root tools may touch
DB_PATH=./data/demo.db       # seeded via: uv run python -m scripts.seed_db

# ── Guardrails ────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60     # per tool, per session
# RATE_LIMIT_BACKEND=memory  # memory | redis — redis shares counters
                             # across server processes (opt-in; needs the
                             # `redis` extra and REDIS_URL below)
# REDIS_URL=redis://localhost:6379/0   # may embed credentials — a secret
# RATE_LIMIT_KEY_PREFIX=mcp-toolkit:rate-limit   # Redis key namespace —
                             # change when deployments share one instance
MAX_TOOL_ITERATIONS=8        # agent loop bound (≤ 50, must terminate)
MAX_TOOL_OUTPUT_CHARS=12000  # tool output truncation (untrusted data cap)
READ_FILE_MAX_BYTES=262144
WRITE_FILE_MAX_BYTES=1048576

# ── Observability ─────────────────────────────────────────────────────
LOG_LEVEL=info               # structlog level; logs go to stderr
METRICS_PORT=                # empty = disabled; e.g. 9108 → /metrics HTTP
OUTPUT_FORMAT=pretty         # pretty | json — agent event stream format

# ── Tracing / evaluation (optional) ────────────────────────────────────
# LangSmith is the only tracing backend. Without keys the eval harness
# runs locally only — nothing is uploaded.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=mcp-agent-toolkit-py

# ── Web console (uv run mcp-toolkit-web) ───────────────────────────────
WEB_HOST=127.0.0.1           # loopback; 0.0.0.0 only inside a container —
                             # the console is unauthenticated
WEB_PORT=3000
WEB_CORS_ORIGIN=http://localhost:5173  # Vite dev server only; prod is same-origin

# ── Prompt Registry ────────────────────────────────────────────────────
# PROMPT_VERSION_AGENT_SYSTEM=latest-promoted   # or an integer version
# PROMPT_VERSION_JUDGE_RUBRIC=latest-promoted
# PROMPT_REGISTRY_DIR=./prompts
# PROMPT_AUDIT_PATH=./data/prompt-registry/audit.jsonl
# PROMPT_AB_RESULTS_DIR=./data/prompt-registry/ab
# ENABLE_PROMPT_ADMIN=       # empty/0 = read-only registry API (default)

# ── Run telemetry / budget ─────────────────────────────────────────────
# RUN_BUDGET_USD=            # empty = no hard cap; e.g. 0.05 → run stops with
                             # terminatedBy "budget_limit" at the cap
# MODEL_PRICING_JSON=        # optional {"model": {"prompt": <usd>, "completion": <usd>}}
                             # per 1M tokens — overrides the committed price table

# ── MCP transport ──────────────────────────────────────────────────────
# MCP_TRANSPORT=stdio        # stdio | streamable-http
# MCP_HTTP_HOST=127.0.0.1    # loopback only unless you know what you are doing
# MCP_HTTP_PORT=8000
# MCP_HTTP_TOKEN=            # bearer token — REQUIRED on a non-loopback host
