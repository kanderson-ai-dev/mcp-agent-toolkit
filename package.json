{
  "name": "mcp-agent-toolkit",
  "version": "0.1.0",
  "description": "Production-shaped MCP server + agent client: tool calling over an open standard, with guardrails and observability.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "seed:db": "tsx scripts/seed-db.ts",
    "server": "tsx src/server/index.ts",
    "server:dist": "node dist/server/index.js",
    "agent": "tsx src/client/index.ts",
    "demo": "tsx scripts/demo.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.2",
    "better-sqlite3": "^12.4.1",
    "node-html-parser": "^7.0.1",
    "openai": "^5.23.2",
    "pino": "^9.9.0",
    "@prometheus-io/client": "^0.16.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.5.2",
    "eslint": "^10.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^5.0.2",
    "@vitest/coverage-v8": "^5.0.2"
  }
}
